# === Приложение ===
APP_NAME=resume-designer
APP_ENV=development
LOG_LEVEL=INFO

# === GigaChat (заглушки — заполнить после выдачи кредов) ===
# Для простого Bearer-токена используйте GIGACHAT_API_KEY.
# Для OAuth client_credentials используйте GIGACHAT_AUTH_KEY (base64(client_id:client_secret)).
GIGACHAT_API_KEY=
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_USE_STUB=true
# Если используется самоподписанный сертификат, временно отключите проверку верификации.
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=

# === Мессенджер / интеграция ===
MESSENGER_WEBHOOK_SECRET=
DEFAULT_LOCALE=ru
